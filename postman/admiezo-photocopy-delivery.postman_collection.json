{
  "info": {
    "name": "ADMIEZO Photocopy Delivery",
    "description": "University intake, admin approval, masked delivery, and university acknowledgement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "apiKey", "value": "" },
    { "key": "adminCookie", "value": "" },
    { "key": "csrfToken", "value": "" },
    { "key": "scriptId", "value": "" },
    { "key": "applicationId", "value": "UNI-COPY-1001" },
    { "key": "requestId", "value": "" },
    { "key": "requestVersion", "value": "1" }
  ],
  "item": [
    {
      "name": "University submits photocopy request",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-ADMIEZO-API-KEY", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"external_application_id\": \"{{applicationId}}\",\n  \"identity_reference\": \"STUDENT-COPY-001\",\n  \"script_id\": \"{{scriptId}}\",\n  \"purpose\": \"copy\",\n  \"release_mode\": \"masked\"\n}" },
        "url": "{{baseUrl}}/api/v1/phase4/official-portal/photocopy-requests"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('photocopy request accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));", "if (pm.response.code < 300) pm.collectionVariables.set('requestId', pm.response.json().id);"] } }]
    },
    {
      "name": "Admin approves masked copy",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Cookie", "value": "{{adminCookie}}" },
          { "key": "X-CSRFToken", "value": "{{csrfToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"version\": {{requestVersion}}, \"approve\": true, \"release_mode\": \"masked\"}" },
        "url": "{{baseUrl}}/api/v1/phase4/student/requests/{{requestId}}/decision"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('photocopy approved', () => pm.expect(pm.response.code).to.eql(200));", "if (pm.response.code < 300) pm.collectionVariables.set('requestVersion', pm.response.json().version);"] } }]
    },
    {
      "name": "University downloads approved copy",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-ADMIEZO-API-KEY", "value": "{{apiKey}}" }],
        "url": "{{baseUrl}}/api/v1/phase4/official-portal/photocopy-requests/{{requestId}}/download"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('delivery available', () => pm.expect(pm.response.code).to.eql(200));", "pm.test('evaluator marks excluded', () => pm.expect(pm.response.json().evaluator_marks_included).to.eql(false));"] } }]
    },
    {
      "name": "University acknowledges delivery",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-ADMIEZO-API-KEY", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"delivery_reference\": \"UNIVERSITY-HANDOVER-1001\"}" },
        "url": "{{baseUrl}}/api/v1/phase4/official-portal/photocopy-requests/{{requestId}}/acknowledge"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('delivery acknowledged', () => pm.expect(pm.response.code).to.eql(200));", "pm.test('status delivered', () => pm.expect(pm.response.json().status).to.eql('delivered'));"] } }]
    }
  ]
}
